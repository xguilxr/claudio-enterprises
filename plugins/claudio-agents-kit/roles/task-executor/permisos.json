{
  "permissions": {
    "defaultMode": "default",

    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git rebase:*)",
      "Bash(git tag -d:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(terraform:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(gh secret:*)",
      "Bash(gh release:*)",
      "Bash(npm publish:*)",
      "Bash(pip install:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*credential*)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Edit(~/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./roles/task-executor/catalogo.yaml)",
      "Edit(./roles/task-executor/permisos.json)",
      "WebFetch",
      "WebSearch"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git branch -D:*)",
      "Bash(git merge:*)"
    ],

    "allow": [
      "Read(./**)",
      "Glob",
      "Grep",
      "Edit(./**)",
      "Write(./**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(uv run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)",
      "Bash(vitest:*)",
      "Bash(tsc:*)"
    ]
  }
}
